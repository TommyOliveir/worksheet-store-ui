# Copy to .env.local and fill in. NEXT_PUBLIC_* values are inlined into the
# browser bundle at build time, so only put public values here.

# Where the browser calls the API (no trailing slash).
# Local: http://localhost:3001 (direct). Production: /api (proxied, see API_ORIGIN).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Server-only. The API's real origin, e.g. https://your-api.onrender.com.
# Set in production: /api/* is rewritten to it, and server rendering calls it
# directly. Leave unset locally.
API_ORIGIN=

# Stripe publishable key (client-side checkout)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google sign-in: OAuth "Web application" client ID (same value as the API's GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
